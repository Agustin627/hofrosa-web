// Configuración de Cloudflare Workers para la web (archivos estáticos + API de precios).
// Cloudflare la usa al publicar desde GitHub (Workers Builds) con: npx wrangler deploy
{
  // Nombre del Worker = primera parte de la dirección: www.<subdominio de la cuenta>.workers.dev
  "name": "www",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // La web vive en la dirección gratis de Cloudflare (<nombre>.<subdominio>.workers.dev).
  // Access protege ahí /precios y /precios/*. Sin direcciones de vista previa: no pasarían por Access.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // El Worker atiende solo la API; todo lo demás lo sirve Cloudflare directamente.
    "run_worker_first": ["/api/*", "/precios/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "PRECIOS", "class_name": "Precios" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Precios"] }],
  // ACCESS_EQUIPO, ACCESS_AUD y CORREOS_ADMIN se cargan en el panel de Cloudflare (como secretos):
  // no se borran al publicar desde GitHub.
  "keep_vars": true,
  "observability": { "enabled": true }
}
